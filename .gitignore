config-backup-*.tar.gz.sha256

# VirusTotal API key and quota tracking
config/vt-api.conf
vt-upload-quota

# AIDE database (optional - consider keeping baseline for portability)
/var/lib/aide/aide.db*

# Temporary files
*.tmp
*.swp
*~
.tmp.recovery

# Editor-specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
.DS_Store?
._*
Desktop.ini
Thumbs.db

# Compiled binaries or Python cache (if any added later)
__pycache__/
*.pyc
*.pyo
*.so

# Recovery key artifacts (temporary during creation)
recovery-mount-*

# Backup and archive files
*.backup
*.tar.gz
